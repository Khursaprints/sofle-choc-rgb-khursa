#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/ext_power.h>
#include <dt-bindings/zmk/rgb_fx.h>
#include <dt-bindings/zmk/pointing.h>

/ {
    behaviors {
        oledanim: oledanim {
            compatible = "zmk,behavior-oled-anim";
            #binding-cells = <0>;
        };
        oledset: oledset {
            compatible = "zmk,behavior-oled-set";
            #binding-cells = <1>;
        };
        wpmview: wpmview {
            compatible = "zmk,behavior-wpm-view";
            #binding-cells = <0>;
        };
        wpmset: wpmset {
            compatible = "zmk,behavior-wpm-set";
            #binding-cells = <1>;
        };
        sleepcfg: sleepcfg {
            compatible = "zmk,behavior-sleep-cfg";
            #binding-cells = <2>;
        };
        dmac: dmac {
            compatible = "zmk,behavior-dynamic-macro";
            #binding-cells = <1>;
        };
        mwheel: mwheel {
            compatible = "zmk,behavior-mouse-wheel";
            #binding-cells = <1>;
        };

        enc_l0: enc_l0 {
            compatible = "zmk,behavior-sensor-rotate-dynamic";
            #sensor-binding-cells = <0>;
            sensor-index = <0>;
            layer-id = <0>;
            bindings = <&kp C_VOL_UP>, <&kp C_VOL_DN>;
        };
        enc_r0: enc_r0 {
            compatible = "zmk,behavior-sensor-rotate-dynamic";
            #sensor-binding-cells = <0>;
            sensor-index = <1>;
            layer-id = <0>;
            bindings = <&kp UP>, <&kp DOWN>;
        };
        enc_l1: enc_l1 {
            compatible = "zmk,behavior-sensor-rotate-dynamic";
            #sensor-binding-cells = <0>;
            sensor-index = <0>;
            layer-id = <1>;
            bindings = <&rgbfx RGBFX_NEXT(0)>, <&rgbfx RGBFX_PREVIOUS(0)>;
        };
        enc_r1: enc_r1 {
            compatible = "zmk,behavior-sensor-rotate-dynamic";
            #sensor-binding-cells = <0>;
            sensor-index = <1>;
            layer-id = <1>;
            bindings = <&rgbfx RGBFX_HUE_UP(0)>, <&rgbfx RGBFX_HUE_DOWN(0)>;
        };
        enc_l2: enc_l2 {
            compatible = "zmk,behavior-sensor-rotate-dynamic";
            #sensor-binding-cells = <0>;
            sensor-index = <0>;
            layer-id = <2>;
            bindings = <&rgbfx RGBFX_BRIGHTEN(0)>, <&rgbfx RGBFX_DIM(0)>;
        };
        enc_r2: enc_r2 {
            compatible = "zmk,behavior-sensor-rotate-dynamic";
            #sensor-binding-cells = <0>;
            sensor-index = <1>;
            layer-id = <2>;
            bindings = <&rgbfx RGBFX_SPD_UP(0)>, <&rgbfx RGBFX_SPD_DOWN(0)>;
        };
    };
};

/ {
    keymap {
        compatible = "zmk,keymap";

        layer_0 {
            display-name = "Daily";
            bindings = <
                &kp ESC &kp N1 &kp N2 &kp N3 &kp N4 &kp N5 &kp N6 &kp N7 &kp N8 &kp N9 &kp N0 &kp DEL
                &kp TAB &kp Q &kp W &kp E &kp R &kp T &kp Y &kp U &kp I &kp O &kp P &kp LS(MINUS)
                &kp LGUI &kp A &kp S &kp D &kp F &kp G &kp H &kp J &kp K &kp L &kp SEMI &kp KP_MULTIPLY
                &kp LSHFT &kp Z &kp X &kp C &kp V &kp B &kp C_MUTE &kp C_PLAY &kp N &kp M &kp COMMA &kp DOT &kp FSLH &kp PSCRN
                &kp CAPS &kp LALT &mo 1 &kp LCTRL &kp SPACE &kp RET &kp BSPC &mo 2 &kp RALT &kp RSHFT
            >;
            sensor-bindings = <&enc_l0 &enc_r0>;
        };

        layer_1 {
            display-name = "MO1";
            bindings = <
                &trans &kp F1 &kp F2 &kp F3 &kp F4 &kp F5 &kp F6 &kp F7 &kp F8 &kp F9 &kp F10 &kp F23
                &kp GRAVE &kp F11 &kp F12 &kp RA(E) &rgbfx RGBFX_TOGGLE(0) &rgbfx RGBFX_NEXT(0) &trans &trans &kp UP &kp SQT &trans &kp F24
                &trans &kp SEMI &kp LS(LBKT) &kp LS(RBKT) &rgbfx RGBFX_HUE_DOWN(0) &rgbfx RGBFX_HUE_UP(0) &trans &kp LEFT &kp DOWN &kp RIGHT &trans &kp HOME
                &trans &studio_unlock &trans &trans &rgbfx RGBFX_DIM(0) &rgbfx RGBFX_BRIGHTEN(0) &wpmview &oledanim &trans &trans &trans &trans &kp BSLH &kp END
                &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans
            >;
            sensor-bindings = <&enc_l1 &enc_r1>;
        };

        layer_2 {
            display-name = "MO2";
            bindings = <
                &bt BT_CLR &bt BT_SEL 0 &bt BT_SEL 1 &bt BT_SEL 2 &bt BT_SEL 3 &bt BT_SEL 4 &trans &kp LBKT &kp RBKT &kp LS(N0) &kp KP_PLUS &kp DEL
                &trans &trans &trans &trans &trans &trans &kp PG_UP &kp N7 &kp N8 &kp N9 &kp KP_MINUS &kp BSPC
                &trans &kp LBKT &trans &trans &trans &trans &kp PG_DN &kp N4 &kp N5 &kp N6 &kp KP_MULTIPLY &kp KP_MULTIPLY
                &trans &kp K_UNDO &kp K_CUT &kp K_COPY &kp K_PASTE &trans &trans &rgbfx RGBFX_TOGGLE(0) &kp N0 &kp N1 &kp N2 &kp N3 &kp KP_SLASH &kp COMMA
                &trans &trans &trans &trans &trans &trans &kp N0 &kp KP_DOT &kp RALT &trans
            >;
            sensor-bindings = <&enc_l2 &enc_r2>;
        };
    };
};
